{
  "manifest_version": 3,
  "name": "UnlockMyCeler",
  "version": "2.0",
  "description": "Smart Record & Replay Automation for CelerSCET.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "Start UnlockMyCeler"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.celerscet.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.mp4"
      ],
      "matches": [
        "*://*.celerscet.com/*"
      ]
    }
  ]
}